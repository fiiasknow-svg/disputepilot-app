# DisputePilot environment template
# Copy to .env.local for local development only.
# Never commit real .env files, passwords, API keys, tokens, or provider secrets.

# -----------------------------------------------------------------------------
# App/public config
# -----------------------------------------------------------------------------
# Optional for local Playwright/specs. Leave unset for normal local tests so
# tests use http://127.0.0.1:3201 from playwright.config.ts.
BASE_URL=http://127.0.0.1:3201

# -----------------------------------------------------------------------------
# Supabase/database
# -----------------------------------------------------------------------------
# Required for Supabase-backed runtime features. Values are public browser config,
# but still use buyer-owned project values and avoid seller personal projects.
NEXT_PUBLIC_SUPABASE_URL=https://<buyer-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<buyer-supabase-anon-key>

# -----------------------------------------------------------------------------
# Test/local Playwright
# -----------------------------------------------------------------------------
# Playwright reads CI automatically in playwright.config.ts. Usually set by CI.
CI=false

# -----------------------------------------------------------------------------
# Live smoke testing
# -----------------------------------------------------------------------------
# Test-only. Use only for authenticated live smoke tests against a buyer-owned
# demo account. Do not use personal credentials.
E2E_EMAIL=<demo-admin-email@example.test>
E2E_PASSWORD=<demo-admin-password>

# -----------------------------------------------------------------------------
# Original visual audit
# -----------------------------------------------------------------------------
# Internal audit-only. Required only when running authenticated original-site
# visual comparison. Do not include these in buyer-facing packages.
ORIGINAL_E2E_EMAIL=<original-audit-email>
ORIGINAL_E2E_PASSWORD=<original-audit-password>

# -----------------------------------------------------------------------------
# Optional AI / email providers
# -----------------------------------------------------------------------------
# Optional. Used by app/api/rewrite-letter and app/api/analyze-credit.
OPENAI_API_KEY=<buyer-openai-api-key>

# Optional. Used by app/api/send-email.
RESEND_API_KEY=<buyer-resend-api-key>

# -----------------------------------------------------------------------------
# Optional billing/payment
# -----------------------------------------------------------------------------
# TODO/unknown: Stripe placeholders appeared in an old ignored local example, but
# no verified runtime code currently reads these variables. Do not configure or
# claim Stripe billing is live until billing integration is implemented/verified.
# STRIPE_SECRET_KEY=<buyer-stripe-secret-key>
# STRIPE_PUBLISHABLE_KEY=<buyer-stripe-publishable-key>

# -----------------------------------------------------------------------------
# Optional email/SMS/integrations
# -----------------------------------------------------------------------------
# TODO/unknown: No verified SMTP, Twilio, Vercel token, or other integration env
# variables were found in runtime code during the sale-readiness scan. Add only
# when corresponding code/integration is implemented and documented.
# SMTP_HOST=<buyer-smtp-host>
# SMTP_USER=<buyer-smtp-user>
# SMTP_PASSWORD=<buyer-smtp-password>
# TWILIO_ACCOUNT_SID=<buyer-twilio-account-sid>
# TWILIO_AUTH_TOKEN=<buyer-twilio-auth-token>